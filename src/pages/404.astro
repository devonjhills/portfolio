---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#050806" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>404 — Devon Hills</title>
  </head>
  <body>
    <div class="shell error-shell">
      <main>
        <section class="window error-page">
          <div class="title-bar">
            <span>Error 404</span>
            <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="window-body">
            <p class="eyebrow">Page not found</p>
            <h1>Nothing here.</h1>
            <p class="intro">The address does not point to anything on this site.</p>
            <a class="button primary" href="/">Return home</a>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
