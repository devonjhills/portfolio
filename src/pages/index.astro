---
import "../styles/global.css";
import {
  Accessibility,
  BriefcaseBusiness,
  CodeXml,
  ExternalLink,
  FileText,
  FolderKanban,
  GraduationCap,
  Mail,
  Sparkles,
  Wrench,
} from "@lucide/astro";
import { capabilities, education, experience, profile, projects } from "../data/portfolio";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const title = `${profile.name} — ${profile.role}`;
const description = "Software engineer building accessible web applications, public services, and practical AI-powered tools.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050806" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://devonhills.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Devon Hills, Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://devonhills.dev/og-image.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell" id="top">
      <header class="site-header" aria-label="Site header">
        <a class="site-name" href="#top" aria-label="Devon Hills, home"><span aria-hidden="true">DH</span>Devon Hills</a>
        <nav aria-label="Primary navigation">
          <a class="button" href="#projects"><FolderKanban aria-hidden="true" />Projects</a>
          <a class="button" href="#experience"><BriefcaseBusiness aria-hidden="true" />Experience</a>
          <a class="button" href="#contact"><Mail aria-hidden="true" />Contact</a>
        </nav>
      </header>

      <main id="main">
        <section class="window hero" aria-labelledby="intro-title">
          <div class="title-bar">
            <span>Devon Hills — Portfolio</span>
            <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="window-body hero-layout">
            <div class="hero-main">
              <p class="eyebrow">Software engineer / 2026</p>
              <h1 id="intro-title">Devon Hills</h1>
              <p class="role">Software Engineer</p>
              <p class="intro">{profile.introduction}</p>
              <div class="action-row" aria-label="Featured links">
                <a class="button primary" href="/resume.pdf"><FileText aria-hidden="true" />View résumé</a>
                <a class="button" href={`mailto:${profile.email}`}><Mail aria-hidden="true" />Email me</a>
              </div>
            </div>
            <aside class="inset strengths" aria-label="Core areas">
              <h2>Core areas</h2>
              <ul>
                <li><CodeXml aria-hidden="true" /><span>Frontend development</span></li>
                <li><Accessibility aria-hidden="true" /><span>Accessible interfaces</span></li>
                <li><Sparkles aria-hidden="true" /><span>AI / LLM integration</span></li>
              </ul>
            </aside>
          </div>
        </section>

        <section class="window" id="projects" aria-labelledby="projects-title">
          <div class="title-bar">
            <h2 id="projects-title">Projects</h2>
            <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="window-body">
            <p class="section-intro">Selected work across modern web applications, automation, and public-facing tools.</p>
            <div class="project-grid">
              {projects.map((project, index) => (
                <article class="project-card">
                  <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <ul class="technology-list" aria-label={`${project.name} technologies`}>
                    {project.technologies.map((technology) => <li>{technology}</li>)}
                  </ul>
                  <div class="action-row project-links">
                    {project.liveUrl && <a class="button" href={project.liveUrl} target="_blank" rel="noreferrer">Live <ExternalLink aria-hidden="true" /></a>}
                    <a class="button" href={project.repositoryUrl} target="_blank" rel="noreferrer">Source <CodeXml aria-hidden="true" /></a>
                  </div>
                </article>
              ))}
            </div>
            <p class="more-link"><a href={profile.github} target="_blank" rel="noreferrer"><CodeXml aria-hidden="true" />More work on GitHub <ExternalLink aria-hidden="true" /></a></p>
          </div>
        </section>

        <section class="window" id="experience" aria-labelledby="experience-title">
          <div class="title-bar">
            <h2 id="experience-title">Experience</h2>
            <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="window-body">
            <div class="experience-list">
              {experience.map((position) => (
                <article class="position">
                  <span class="timeline-marker" aria-hidden="true"></span>
                  <div class="position-heading">
                    <div>
                      <h3>{position.role}</h3>
                      <p class="company">{position.company}</p>
                    </div>
                    <div class="position-meta">
                      <p>{position.dates}</p>
                      <p>{position.location}</p>
                    </div>
                  </div>
                  <ul>{position.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
                </article>
              ))}
            </div>
            <div class="supporting-info">
              <div class="inset">
                <h3><Wrench aria-hidden="true" />Capabilities</h3>
                <p>{capabilities.join(" · ")}</p>
              </div>
              <div class="inset">
                <h3><GraduationCap aria-hidden="true" />Education</h3>
                <p>{education.degree}<br />{education.school} · {education.date}<br />{education.honors}</p>
              </div>
            </div>
          </div>
        </section>

        <section class="window contact" id="contact" aria-labelledby="contact-title">
          <div class="title-bar">
            <h2 id="contact-title">Get in touch</h2>
            <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="window-body contact-layout">
            <div>
              <p class="contact-lede">I’m always interested in thoughtful software, difficult problems, and good teams.</p>
              <a class="button primary" href={`mailto:${profile.email}`}><Mail aria-hidden="true" />Send an email</a>
            </div>
            <dl class="contact-links">
              <dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
              <dt>GitHub</dt><dd><a href={profile.github} target="_blank" rel="noreferrer">devonjhills <ExternalLink aria-hidden="true" /></a></dd>
              <dt>LinkedIn</dt><dd><a href={profile.linkedin} target="_blank" rel="noreferrer">devonjhills <ExternalLink aria-hidden="true" /></a></dd>
              <dt>Résumé</dt><dd><a href="/resume.pdf">Download PDF</a></dd>
            </dl>
          </div>
        </section>
      </main>

      <footer>
        <p>© {new Date().getFullYear()} Devon Hills</p>
        <a href="#top">Back to top</a>
      </footer>
    </div>
  </body>
</html>
